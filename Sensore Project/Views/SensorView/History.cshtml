@{
    ViewData["Title"] = "Sensor History";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-4">
    <h2 class="mb-3 text-primary fw-bold">📊 Sensor History</h2>

    <div class="alert alert-info">Live sensor monitoring — auto refresh every 5 seconds</div>

    <table class="table table-bordered table-striped text-center" id="sensorTable">
        <thead class="table-dark">
            <tr>
                <th>Pressure</th>
                <th>Timestamp</th>
                <th>Anomaly</th>
                <th>Score</th>
                <th>Risk Level</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
    async function loadHistory() {
        const res = await fetch("/api/sensordata/history?count=200");
        const data = await res.json();

        const tbody = document.querySelector("#sensorTable tbody");
        tbody.innerHTML = "";

        data.forEach(row => {
            const tr = document.createElement("tr");

            // highlight anomaly rows
            if (row.anomaly === true) tr.classList.add("table-danger");

            tr.innerHTML = `
                <td>${row.pressure}</td>
                <td>${new Date(row.timestamp).toLocaleString()}</td>
                <td>${row.anomaly ? "❗ Yes" : "✔ No"}</td>
                <td>${row.score.toFixed(2)}</td>
                <td><span class="badge bg-${getRiskColor(row.riskLevel)}">${row.riskLevel}</span></td>
            `;

            tbody.appendChild(tr);
        });
    }

    function getRiskColor(level) {
        if (level === "Critical") return "danger";
        if (level === "High") return "warning";
        if (level === "Medium") return "info";
        return "success"; // Low
    }

    loadHistory();      // load initial data
    setInterval(loadHistory, 5000); // auto-refresh every 5 sec
</script>