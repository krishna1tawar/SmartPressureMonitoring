@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">
        <div class="card-body text-center p-5">

            <h1 class="text-danger fw-bold mb-3">⚠️ An Error Occurred</h1>
            <p class="text-muted mb-4">
                Something went wrong while processing your request.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="mb-3">
                    <strong>Request ID:</strong>
                    <code>@Model.RequestId</code>
                </p>
            }

            <h5 class="mt-4">Development Mode</h5>
            <p class="text-muted">
                Running the app in <strong>Development</strong> will show detailed exception information.
            </p>

            <p class="text-muted">
                Enable development mode by setting:
                <br />
                <code>ASPNETCORE_ENVIRONMENT = Development</code>
            </p>

        </div>
    </div>

</div>