@{
    ViewData["Title"] = "Sensor Dashboard";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📊 Smart Pressure Monitoring Dashboard</h2>

    <!-- Latest Pressure Chart -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            Latest Pressure Readings
        </div>
        <div class="card-body">
            <canvas id="pressureChart" height="100"></canvas>
            <div id="noPressureData" class="text-muted text-center mt-2 d-none">
                No sensor data available yet. When new readings are stored via <code>/api/SensorData</code>,
                the chart will update automatically.
            </div>
        </div>
    </div>

    <!-- Anomaly / Alerts Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            ⚠ Detected Alerts / Anomalies
        </div>
        <div class="card-body">
            <table class="table table-striped mb-0" id="anomalyTable">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Pressure (PSI)</th>
                        <th>Message</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <div id="noAlertsData" class="text-muted text-center mt-2 d-none">
                No alerts have been generated yet.
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let pressureChart = null;

    async function loadDashboard() {
        await loadPressureChart();
        await loadAlerts();
    }

    // ============================
    // Load Latest Pressure History
    // ============================
    async function loadPressureChart() {
        const noDataLabel = document.getElementById("noPressureData");

        try {
            const res = await fetch('/api/SensorData/history');
            if (!res.ok) {
                console.error("History HTTP error:", res.status);
                noDataLabel.classList.remove("d-none");
                return;
            }

            const data = await res.json();

            if (!Array.isArray(data) || data.length === 0) {
                // No readings in DB
                noDataLabel.classList.remove("d-none");
                if (pressureChart) {
                    pressureChart.destroy();
                    pressureChart = null;
                }
                return;
            }

            noDataLabel.classList.add("d-none");

            const labels = data.map(x =>
                new Date(x.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            );
            const values = data.map(x => x.pressure);

            const ctx = document.getElementById('pressureChart').getContext('2d');

            if (!pressureChart) {
                pressureChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Pressure (PSI)',
                            data: values,
                            borderWidth: 2,
                            borderColor: 'blue',
                            tension: 0.3
                        }]
                    }
                });
            } else {
                pressureChart.data.labels = labels;
                pressureChart.data.datasets[0].data = values;
                pressureChart.update();
            }
        } catch (err) {
            console.error("Error loading pressure history:", err);
            noDataLabel.classList.remove("d-none");
        }
    }

    // ============================
    // Load Alerts Table
    // ============================
    async function loadAlerts() {
        const noAlertsLabel = document.getElementById("noAlertsData");
        const tbody = document.querySelector("#anomalyTable tbody");
        tbody.innerHTML = "";

        try {
            const res = await fetch('/api/alerts/list'); // controller route is case-insensitive
            if (!res.ok) {
                console.error("Alerts HTTP error:", res.status);
                noAlertsLabel.classList.remove("d-none");
                return;
            }

            const data = await res.json();

            if (!Array.isArray(data) || data.length === 0) {
                noAlertsLabel.classList.remove("d-none");
                return;
            }

            noAlertsLabel.classList.add("d-none");

            data.forEach(a => {
                const pressureText = (typeof a.pressure === "number")
                    ? a.pressure.toFixed(2)
                    : "-";

                tbody.innerHTML += `
                    <tr>
                        <td>${new Date(a.timestamp).toLocaleString()}</td>
                        <td>${pressureText}</td>
                        <td>${a.message ?? ""}</td>
                        <td>
                            ${a.isResolved
                                ? "<span class='badge bg-success'>Resolved</span>"
                                : "<span class='badge bg-danger'>Active</span>"}
                        </td>
                    </tr>
                `;
            });
        } catch (err) {
            console.error("Error loading alerts:", err);
            noAlertsLabel.classList.remove("d-none");
        }
    }

    // Auto-refresh every 5 seconds
    loadDashboard();
    setInterval(loadDashboard, 5000);
</script>