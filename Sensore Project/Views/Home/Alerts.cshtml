@{
    ViewData["Title"] = "Alerts - Anomaly History";
}

<div class="container mt-4">

    <h2 class="mb-3 text-center">⚠️ Anomaly Alerts</h2>

    <p class="text-muted text-center">
        All detected anomaly events recorded by the system.
    </p>

    <!-- Summary Cards -->
    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Alerts</h6>
                    <h3 id="totalAlerts" class="fw-bold">0</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Most Recent Alert</h6>
                    <h5 id="latestAlertTime" class="fw-bold">-</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Highest Pressure</h6>
                    <h5 id="maxPressureAlert" class="fw-bold">-</h5>
                </div>
            </div>
        </div>

    </div>

    <!-- Alerts Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="mb-3">📋 Alerts List</h5>

            <table class="table table-hover" id="alertsTable">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Pressure (PSI)</th>
                        <th>Message</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Resolve</th>
                    </tr>
                </thead>
                <tbody id="alertsBody"></tbody>
            </table>

            <div id="noAlerts" class="text-muted text-center mt-3 d-none">
                No alerts to show.
            </div>

        </div>
    </div>

</div>

<script>
    async function loadAlerts() {
        const res = await fetch("/api/alerts/list");
        const alerts = await res.json();

        const tbody = document.getElementById("alertsBody");
        tbody.innerHTML = "";

        document.getElementById("totalAlerts").innerText = alerts.length;

        if (alerts.length === 0) {
            document.getElementById("noAlerts").classList.remove("d-none");
            return;
        }

        document.getElementById("noAlerts").classList.add("d-none");

        // Most recent
        document.getElementById("latestAlertTime").innerText =
            new Date(alerts[0].timestamp).toLocaleString();

        // Highest pressure
        const maxP = Math.max(...alerts.map(a => a.pressure));
        document.getElementById("maxPressureAlert").innerText = maxP.toFixed(2) + " PSI";

        // Fill table
        alerts.forEach(a => {
            tbody.innerHTML += `
                <tr>
                    <td>${a.id}</td>
                    <td>${a.pressure.toFixed(2)}</td>
                    <td>${a.message}</td>
                    <td>${new Date(a.timestamp).toLocaleString()}</td>
                    <td>
                        ${a.isResolved
                            ? "<span class='badge bg-success'>Resolved</span>"
                            : "<span class='badge bg-danger'>Active</span>"}
                    </td>
                    <td>
                        ${a.isResolved
                            ? "-"
                            : `<button class="btn btn-sm btn-primary" onclick="resolveAlert(${a.id})">Resolve</button>`}
                    </td>
                </tr>`;
        });
    }

    async function resolveAlert(id) {
        await fetch(`/api/alerts/resolve/${id}`, { method: "POST" });
        loadAlerts();
    }

    loadAlerts();
    setInterval(loadAlerts, 5000);
</script>