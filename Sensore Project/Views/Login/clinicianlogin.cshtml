@{
    ViewData["Title"] = "Clinician Login";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg p-4 border-0">
                <h3 class="text-center mb-3">🩺 Clinician Login</h3>
                <p class="text-muted text-center">Authorized personnel only</p>

                <form>
                    <div class="mb-3">
                        <label class="form-label">Clinician ID</label>
                        <input type="text" class="form-control" placeholder="Enter clinician ID">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" placeholder="Enter your password">
                    </div>

                    <button type="submit" class="btn btn-success w-100">Login</button>
                </form>
            </div>

        </div>
    </div>

</div>